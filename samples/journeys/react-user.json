{"name": "React shop: a customer through the UI",
 "steps": [
  {"goto": "/login"},
  {"fill": {"selector": "input[name=email]", "value": "${env:RS_EMAIL}"}},
  {"fill": {"selector": "input[name=password]", "value": "${env:RS_PASS}"}},
  {"click": {"text": "Sign in", "selector": "button"}, "required": true},
  {"wait_idle": true},
  {"goto": "/products/3"},
  {"click": {"text": "Add to cart"}},
  {"fill": {"selector": "input[name=text]", "value": "Great product"}},
  {"click": {"text": "Post review"}},
  {"goto": "/cart"},
  {"click": {"text": "Checkout"}},
  {"wait_idle": true},
  {"goto": "/account"},
  {"fill": {"selector": "input[name=name]", "value": "Alice Q"}},
  {"click": {"text": "Save profile"}},
  {"wait_idle": true}
 ]}
